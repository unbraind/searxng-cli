{
  "name": "searxng-cli",
  "version": "2026.7.16",
  "description": "SearXNG CLI - Enhanced TypeScript search client for SearXNG instances with TOON format support, persistent caching, and AI agent mode",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "searxng-cli": "./dist/searxng-cli.js",
    "searxng": "./dist/searxng-cli.js"
  },
  "scripts": {
    "build": "bash scripts/build.sh",
    "build:full": "bun run build && tsc --emitDeclarationOnly --declaration",
    "build:watch": "tsc --watch",
    "start": "node dist/searxng-cli.js",
    "dev": "bun src/searxng-cli.ts",
    "test": "vitest run tests/unit",
    "test:unit": "vitest run tests/unit",
    "test:e2e": "vitest run tests/e2e",
    "test:watch": "vitest",
    "test:coverage": "bash scripts/test-coverage.sh",
    "test:e2e:live": "vitest run tests/e2e/cli.test.ts",
    "test:e2e:searxng": "bash scripts/e2e-searxng.sh",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "clean": "rm -rf dist",
    "prepublishOnly": "bun run clean && bun run build",
    "lint": "bun run typecheck && bun run format:check",
    "version:sync": "bash scripts/sync-version.sh",
    "version:check": "bash scripts/version-check.sh",
    "version:audit": "bash scripts/version-audit-tags.sh",
    "release:check": "bash scripts/release-check.sh",
    "release:pipeline": "node scripts/release/run-release-pipeline.mjs",
    "release:pipeline:dry-run": "node scripts/release/run-release-pipeline.mjs --dry-run --json",
    "release:verify-published": "node scripts/release/verify-published-release.mjs",
    "test:release": "vitest run tests/unit/release-automation.test.ts",
    "changelog:pm:install": "pm install npm:pm-changelog --project",
    "changelog:pm": "node scripts/release/generate-changelog.mjs",
    "changelog:pm:check": "node scripts/release/generate-changelog.mjs --check",
    "changelog:preservation:check": "node scripts/release/check-changelog-preservation.mjs",
    "secrets:history": "bash scripts/secret-scan-history.sh",
    "smoke:package": "bash scripts/package-smoke.sh",
    "release:dry-run": "bash scripts/release-dry-run.sh"
  },
  "keywords": [
    "searxng",
    "search",
    "cli",
    "metasearch",
    "privacy",
    "toon",
    "typescript",
    "llm",
    "ai-agent",
    "search-engine",
    "searx",
    "web-search",
    "terminal",
    "command-line",
    "caching",
    "toon-format",
    "bun"
  ],
  "author": "SearXNG CLI Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unbraind/searxng-cli.git"
  },
  "bugs": {
    "url": "https://github.com/unbraind/searxng-cli/issues"
  },
  "homepage": "https://github.com/unbraind/searxng-cli#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=22.12.0",
    "bun": ">=1.0.0"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@unbrained/pm-cli": "2026.7.21",
    "@vitest/coverage-v8": "4.1.10",
    "esbuild": "0.28.1",
    "prettier": "3.9.5",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@toon-format/toon": "2.3.1",
    "cac": "^7.0.0",
    "commander": "15.0.0",
    "node-html-parser": "9.0.0"
  },
  "overrides": {
    "@hono/node-server": "1.19.14",
    "body-parser": "2.3.0",
    "express-rate-limit": "8.5.2",
    "fast-uri": "3.1.3",
    "hono": "4.12.30",
    "ip-address": "10.2.0",
    "path-to-regexp": "8.4.2",
    "picomatch": "4.0.5",
    "qs": "6.15.3"
  }
}
