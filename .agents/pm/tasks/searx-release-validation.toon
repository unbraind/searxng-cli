  tests/unit/release-automation.test.ts,project,Release state and workflow contract tests
  scripts/release/changelog-baseline.json,project,Immutable preservation dataset
tests[2]:
  - command: "bun run changelog:preservation:check"
    scope: project
    timeout_seconds: 180
    pm_context_mode: tracker
  - command: "bun run test:release"
    scope: project
    timeout_seconds: 180
docs[2]{path,scope,note}:
